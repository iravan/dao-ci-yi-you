REDIS_URL=redis://127.0.0.1:6379
BIND=127.0.0.1:8787
# A host that sets PORT overrides BIND; the service then binds 0.0.0.0:$PORT.
SUPABASE_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# When SUPABASE_JWKS_URL is empty, the JWKS address is derived from SUPABASE_URL,
# which is what the hosted Supabase integration injects.
# HS256 only for local checks. Leave it empty when SUPABASE_JWKS_URL is set.
JWT_HS_SECRET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The page reads this. It is not a server variable.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8787/api
