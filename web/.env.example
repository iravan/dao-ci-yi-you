NEXT_PUBLIC_API_URL=http://127.0.0.1:8787/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DB_SCHEMA=dao_ci_yi_you
# Comma-separated. apple, google, facebook. The API checks SSO_PROVIDERS.
NEXT_PUBLIC_SSO_PROVIDERS=google,apple

# Only for a build with no API, such as the static demo. The live page reads /api/config.
NEXT_PUBLIC_AREA_STEP=0.001
